{
  "private": true,
  "name": "@documenso/root",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "2.3.1",
  "scripts": {
    "postinstall": "patch-package",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@documenso/remix",
    "dev:remix": "turbo run dev --filter=@documenso/remix",
    "start": "turbo run start --filter=@documenso/remix",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,mdx}\"",
    "prepare": "husky && husky install || true",
    "commitlint": "commitlint --edit",
    "clean": "turbo run clean && rimraf node_modules",
    "d": "npm run dx && npm run translate:compile && npm run dev",
    "dx": "npm install --legacy-peer-deps && npm run dx:up && npm run prisma:migrate-dev && npm run prisma:seed",
    "dx:up": "docker compose -f docker/development/compose.yml up -d",
    "dx:down": "docker compose -f docker/development/compose.yml down",
    "ci": "turbo run build --filter=@documenso/remix",
    "prisma:generate": "npm run with:env -- npm run prisma:generate --workspace=@documenso/prisma",
    "prisma:migrate-dev": "npm run with:env -- npm run prisma:migrate-dev --workspace=@documenso/prisma",
    "prisma:migrate-deploy": "npm run with:env -- npm run prisma:migrate-deploy --workspace=@documenso/prisma",
    "prisma:migrate-reset": "npm run with:env -- npm run prisma:migrate-reset --workspace=@documenso/prisma",
    "prisma:seed": "npm run with:env -- npm run prisma:seed --workspace=@documenso/prisma",
    "prisma:studio": "npm run with:env -- npm run prisma:studio --workspace=@documenso/prisma",
    "seed:folders": "npm run with:env -- npx tsx scripts/seeders/folders-seed.ts",
    "with:env": "dotenv -e .env -e .env.local --",
    "reset:hard": "npm run clean && npm install --legacy-peer-deps && npm run prisma:generate",
    "precommit": "npm install --legacy-peer-deps && git add package.json package-lock.json",
    "trigger:dev": "npm run with:env -- npx trigger-cli dev --handler-path=\"/api/jobs\"",
    "make:version": "npm version --workspace=@documenso/remix --no-git-tag-version",
    "translate": "npm run translate:extract && npm run translate:compile",
    "translate:extract": "lingui extract --clean",
    "translate:compile": "lingui compile"
  },
  "packageManager": "npm@10.9.0",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@lingui/cli": "^5.6.0",
    "@prisma/client": "^6.19.0",
    "@trpc/client": "11.8.1",
    "@trpc/react-query": "11.8.1",
    "@trpc/server": "11.8.1",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@ts-rest/serverless": "^3.52.1",
    "@types/crypto-js": "^4.2.2",
    "@types/nodemailer": "^7.0.5",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.10",
    "pdfjs-dist": "5.4.449",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "playwright": "1.56.1",
    "prettier": "^3.6.2",
    "prisma": "^6.19.0",
    "prisma-extension-kysely": "^3.0.0",
    "prisma-json-types-generator": "^3.6.2",
    "prisma-kysely": "^2.2.1",
    "rimraf": "^6.1.2",
    "superjson": "^2.2.5",
    "syncpack": "^14.0.0-alpha.27",
    "trpc-to-openapi": "2.4.0",
    "tsx": "^4.21.0",
    "turbo": "^1.13.4",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4",
    "zod-openapi": "^4.2.4",
    "zod-prisma-types": "3.3.5"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "3.0.81",
    "@azure/storage-blob": "^12.30.0",
    "@documenso/pdf-sign": "^0.1.0",
    "@documenso/prisma": "*",
    "@lingui/conf": "^5.6.0",
    "@lingui/core": "^5.6.0",
    "ai": "^5.0.104",
    "crypto-js": "^4.2.0",
    "inngest-cli": "^1.13.7",
    "luxon": "^3.7.2",
    "patch-package": "^8.0.1",
    "pg": "^8.17.2",
    "react": "^18",
    "resend": "^6.9.2",
    "typescript": "5.6.2",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "pdfjs-dist": "5.4.449",
    "typescript": "5.6.2",
    "zod": "^3.25.76"
  }
}
