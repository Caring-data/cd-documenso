def branchConfig = [
    'main'        : ['production' , 'cd_production', 'rise.caringdata.com'],
    'staging'     : ['staging'    , 'cd_staging'   , 'staging.caringdata.com'],
    'development' : ['development', 'cd_development', 'caringdata.at.services']
]

def config = branchConfig[env.BRANCH_NAME] ?: branchConfig['development']
def (DEPLOY_ENV, AGENT_LABEL, DOMAIN_NAME) = config

pipeline {
    agent { label "${AGENT_LABEL}" }

    environment {
        APP_NAME = 'cd-documenso'
        COMPOSE_PROJECT_NAME = "${APP_NAME}-${DEPLOY_ENV}"
        NODE_ENV = "${DEPLOY_ENV}"

        HEALTH_CHECK_RETRIES = 10
        HEALTH_CHECK_INTERVAL = 10
    }


    stages {
        stage('1. Init') {
            steps {
                script {
                    if (!DOMAIN_NAME) error("❌ No domain configured for branch ${env.BRANCH_NAME}")

                    currentBuild.displayName = "#${BUILD_NUMBER} - ${DEPLOY_ENV}"
                    echo """
                    🚀 DEPLOY INITIATED
                    -------------------
                    Env:    ${DEPLOY_ENV}
                    Agent:  ${AGENT_LABEL}
                    Domain: ${DOMAIN_NAME}
                    -------------------
                    """
                }
            }
        }

        stage('2. Prepare .env') {
            steps {
                sh """
                    set -e
                    ENV_FILE_PATH="/home/caringdata/${DEPLOY_ENV}/caring_data_documenso/.env.${DEPLOY_ENV}"
                    WORKSPACE_ENV_FILE=".env.${DEPLOY_ENV}"

                    cp "\$ENV_FILE_PATH" "\$WORKSPACE_ENV_FILE"
                    cp "\$WORKSPACE_ENV_FILE" .env
                    echo '--- .env file created ---'
                """
            }
        }

        stage('3. Determine Slot') {
            steps {
                dir('deployment') {
                    script {
                        def activeSlot = sh(
                            script: "docker compose ${env.COMPOSE_FILES} --project-name \"${env.COMPOSE_PROJECT_NAME}\" exec -T nginx cat /etc/nginx/conf.d/active_slot.txt 2>/dev/null || echo 'blue'",
                            returnStdout: true
                        ).trim()

                        env.ACTIVE_SLOT = activeSlot ?: 'blue'
                        env.TARGET_SLOT = (env.ACTIVE_SLOT == 'blue') ? 'green' : 'blue'

                        echo "🔵 Active Slot: ${env.ACTIVE_SLOT}"
                        echo "🟢 Target Slot: ${env.TARGET_SLOT} (Deploying here)"
                    }
                }
            }
        }
    }
}