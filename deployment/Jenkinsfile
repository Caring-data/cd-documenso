pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'documenso/documenso'
        // Using GIT_COMMIT as tag for uniqueness, or BRANCH_NAME for latest of that branch
        DOCKER_TAG = "${env.BRANCH_NAME}-${env.GIT_COMMIT.take(7)}"
        COMPOSE_FILE = 'deployment/compose/compose.yml'
    }

    stages {
        stage('Build') {
            steps {
                script {
                    echo "Building Docker image..."
                    sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} -f deployment/Dockerfile ."
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    def envFile = ''
                    
                    if (env.BRANCH_NAME == 'development') {
                        envFile = '.env.development'
                    } else if (env.BRANCH_NAME == 'staging') {
                        envFile = '.env.staging'
                    } else if (env.BRANCH_NAME == 'main') {
                        envFile = '.env.production'
                    } else {
                        echo "Skipping deployment for branch: ${env.BRANCH_NAME}"
                        return
                    }

                    echo "Deploying to ${env.BRANCH_NAME} environment using ${envFile}..."
                    
                    // Ensure the env file exists or is provided (e.g. via Jenkins credentials binding if needed)
                    // Here we assume it exists in the workspace or is created via previous steps/credentials
                    
                    withEnv(["DOCKER_TAG=${DOCKER_TAG}"]) {
                         // We use --env-file to load the specific environment variables
                         // and -f to point to the consolidated compose file
                         sh "docker compose -f ${COMPOSE_FILE} --env-file ${envFile} up -d"
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
